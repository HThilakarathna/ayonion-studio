# Ayonion Studios - SMTP Configuration
# Use your Gmail address and Google App Password for SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@ayonionstudios.com
SMTP_PASS=your-app-password-here
SMTP_AUTH=true
SMTP_SECURE=tls

# Notification Settings
RECEIVER_EMAIL=info@ayonionstudios.com
FROM_NAME="Ayonion Studios"
