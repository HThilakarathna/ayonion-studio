# Ayonion Studios - Environment Configuration for cPanel
# Copy this file to .env and fill in your actual values

# ===== EMAIL/SMTP CONFIGURATION =====
# For cPanel: Settings are typically in Email Accounts > Your Account > More Details
# or Mail > Email Authentication

# cPanel Email Account (the email you created in cPanel)
SMTP_USER=info@ayonionstudios.com

# Your cPanel email password
SMTP_PASS=your_cpanel_email_password

# cPanel's mail server hostname (usually mail.yourdomain.com or localhost)
SMTP_HOST=mail.ayonionstudios.com

# SMTP Port for cPanel (465 for SSL, 587 for TLS, 110/143 for POP/IMAP)
SMTP_PORT=587

# SMTP Security (tls or ssl)
SMTP_SECURE=tls

# From Name (how it appears in email)
FROM_NAME=Ayonion Studios

# ===== OPTIONAL: Forwarding Configuration =====
# Email address to receive inquiries (can be different from SMTP_USER)
INQUIRY_RECIPIENT=info@ayonionstudios.com

# Admin email for error notifications
ADMIN_EMAIL=admin@ayonionstudios.com
